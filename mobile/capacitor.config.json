{
  "appId": "om.almasiya.fleet",
  "appName": "FLEET",
  "webDir": "www",
  "android": {
    "backgroundColor": "#f2f4f7",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT",
      "hidden": false
    }
  },
  "ios": {
    "backgroundColor": "#f2f4f7",
    "contentInset": "never",
    "scrollEnabled": true,
    "allowsLinkPreview": false,
    "webContentsDebuggingEnabled": false
  }
}
